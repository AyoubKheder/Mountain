{
  "name": "mountain",
  "version": "0.1.0",
  "private": true,
  "description": "Mountain \u2014 Advanced Multi-Tenant E-Commerce SaaS Platform",
  "license": "UNLICENSED",
  "workspaces": [
    "packages/*",
    "apps/merchant",
    "apps/storefront",
    "apps/admin",
    "services/api",
    "services/ai",
    "services/worker",
    "services/search",
    "services/notifications"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:smoke": "node scripts/smoke.mjs",
    "test:tenancy": "node scripts/verify-tenancy.mjs",
    "test:commerce": "node scripts/verify-commerce.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
